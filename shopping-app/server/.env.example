# Server
PORT=3000
FRONTEND_URL=http://localhost:5173

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password
DATABASE_NAME=shopping_app

# Sessions: any long random text
SESSION_SECRET=change_me_to_a_long_random_string

# Enter this code on the sign-up page to create an admin account
ADMIN_PASSKEY=choose_a_code

# Stripe test mode (dashboard.stripe.com → Developers → API keys). Required, or the server won't start
STRIPE_SECRET_KEY=sk_test_...
# Printed by: stripe listen --forward-to localhost:3000/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# SendGrid (optional: sign-up and password reset emails)
SENDGRID_API_KEY=SG....

# Sender address for emails. Must be a verified sender in your SendGrid account
EMAIL_FROM=you@example.com