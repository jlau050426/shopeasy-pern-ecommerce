<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/forms.css">
    <link rel="stylesheet" href="/css/product.css">
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>
            <main>
                <form class="product-form" action="/admin/edit-product" method="POST" enctype="multipart/form-data">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="form-control">
                        <input type="hidden" name="id" id="id" value="<%=currentID%>">
                    </div>

                    <div class="form-control">
                        <label for="title">Title</label>
                        <input type="text" name="title" id="title" value="<%=currentTitle %>">
                    </div>

                    <div class="form-control">
                        <label for="image">ImageURL</label>
                        <input type="file" name="image" id="imageURL" value="<%=currentImageURL %>">
                    </div>

                    <div class="form-control">
                        <label for="price">Price</label>
                        <input type="number" name="price" id="price" step="0.01" value="<%=currentPrice %>">
                    </div>

                    <div class="form-control">
                        <label for="description">Description</label>
                        <textarea name="description" id="description" rows="5"><%= currentDescription %> </textarea>
                    </div>

                    <button class="btn" type="submit">Edit Product</button>
                </form>
            </main>
            <%- include('../includes/end.ejs') %>