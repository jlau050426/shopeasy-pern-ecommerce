<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/forms.css">
    <link rel="stylesheet" href="/css/auth.css">
    <link rel="stylesheet" href="/css/flash-message.css">
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>

            <main>
                <% if (errorMessage.length> 0) { %>
                    <div class="user-message user-message--error">
                        <%= errorMessage %>
                    </div>
                    <% } %>
                        <form class="login-form" action="/login" method="POST">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <div class="form-control">
                                <label for="email">E-Mail</label>
                                <input
                                    class="<%= validationError.find((error) => error.path === 'email') ? 'invalid' : ''%>"
                                    type="email" name="email" id="email" value=<%=oldInput.email %>>
                            </div>
                            <div class="form-control">
                                <label for="password">Password</label>
                                <input
                                    class="<%= validationError.find((error) => error.path === 'password') ? 'invalid' : ''%>"
                                    type="password" name="password" id="password" value=<%=oldInput.password %>>
                            </div>
                            <button class="btn" type="submit">Login</button>
                        </form>
                        <div class="centered">
                            <a href="/reset">Reset Password</a>
                        </div>
            </main>
            <%- include('../includes/end.ejs') %>