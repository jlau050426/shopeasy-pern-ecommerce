<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/cart.css">
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>
            <main class="cart-page">
                <div class="cart-container">
                    <header class="cart-header">
                        <h1 class="cart-header__title">Shopping Cart</h1>
                        <% if (cart.length> 0) { %>
                            <span class="cart-header__count">
                                <%= cart.length %>
                                    <%= cart.length===1 ? 'item' : 'items' %>
                            </span>
                            <% } %>
                    </header>

                    <% if (cart.length> 0) { %>
                        <div class="cart-items">
                            <% cart.forEach(c=> { %>
                                <article class="cart-item">
                                    <div class="cart-item__image-wrapper">
                                        <img src="<%= c.imageurl %>" alt="<%= c.title %>" class="cart-item__image">
                                    </div>
                                    <div class="cart-item__details">
                                        <h2 class="cart-item__title">
                                            <%= c.title %>
                                        </h2>
                                        <p class="cart-item__description">
                                            <%= c.description %>
                                        </p>
                                        <div class="cart-item__meta">
                                            <span class="cart-item__price-single">$<%= c.price %>
                                                    <small>each</small></span>
                                            <span class="cart-item__quantity">Qty: <strong>
                                                    <%= c.quantity %>
                                                </strong></span>
                                        </div>
                                    </div>
                                    <div class="cart-item__actions-wrapper">
                                        <span class="cart-item__subtotal">$<%= c.item_total %></span>
                                        <form action="/cart-delete-item" method="POST" class="cart-item__delete-form">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input type="hidden" value="<%= c.id %>" name="productID">
                                            <button class="btn btn--danger" type="submit" aria-label="Remove item">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                    stroke-linejoin="round">
                                                    <polyline points="3 6 5 6 21 6"></polyline>
                                                    <path
                                                        d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                                    </path>
                                                </svg>
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </article>
                                <% }) %>
                        </div>

                        <footer class="cart-summary">
                            <div class="cart-summary__card">
                                <div class="cart-summary__row">
                                    <span>Subtotal</span>
                                    <span>$<%= grandTotal %></span>
                                </div>
                                <div class="cart-summary__row">
                                    <span>Shipping</span>
                                    <span class="cart-summary__free">FREE</span>
                                </div>
                                <div class="cart-summary__divider"></div>
                                <div class="cart-summary__row cart-summary__row--total">
                                    <span class="cart-summary__total-label">Total Price</span>
                                    <span class="cart-summary__total-amount">$<%= grandTotal %></span>
                                </div>
                                <br>
                                <div class="cart-checkout-form">
                                    <a href="/checkout" class="btn btn--checkout-huge">ORDER NOW ($<%= grandTotal %>
                                            )</a>
                                </div>
                                <!-- <form action="/checkout" method="POST" class="cart-checkout-form">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button class="btn btn--checkout-huge" type="submit">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="9" cy="21" r="1"></circle>
                                            <circle cx="20" cy="21" r="1"></circle>
                                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                        </svg>
                                        Order Now ($<%= grandTotal %>)
                                    </button>
                                </form> -->
                            </div>
                        </footer>
                        <% } else { %>
                            <div class="cart-empty">
                                <div class="cart-empty__icon">
                                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="9" cy="21" r="1"></circle>
                                        <circle cx="20" cy="21" r="1"></circle>
                                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6">
                                        </path>
                                    </svg>
                                </div>
                                <h2 class="cart-empty__title">Your Cart is Empty</h2>
                                <p class="cart-empty__text">Explore our collection and add items to your cart.</p>
                                <% if (isAuthenticated) { %>
                                    <a href="/" class="btn btn--primary">Shop Now</a>
                                    <% }else { %>
                                        <a href="/login" class="btn btn--primary">Login To Shop</a>
                                        <% } %>
                            </div>
                            <% } %>
                </div>
            </main>
            <%- include('../includes/end.ejs') %>